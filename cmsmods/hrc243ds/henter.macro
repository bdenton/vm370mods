         MACRO                                                          00010000
&LABEL   HENTER &PATTERN,&RC=NO,&RESULT=NONE,&DWORDS=                   00020000
.* *****************************************************************    00030000
.* *                                                                    00040000
.* *       Defines a new VM/CE method entry point.                      00050000
.* *       Saves registers and establish addressing. Can also           00060000
.* *       generate an inline save area or dynamically allocate one.    00070000
.* *       Save caller's registers in the caller's save area            00080000
.* *                                                                    00090000
.* *       &PATTERN - Selects the entry codee pattern to be used:       00100000
.* *                  STANDARD - Externally available entry point with  00110000
.* *                             standard linkage and CSECT addressing  00120000
.* *                  INTERNAL - Internal use only subroutine. Standard 00130000
.* *                             linkage and CSECT addressing           00140000
.* *                  BLOCK    - Externally available entry point with  00150000
.* *                             standard linkage and local addressing  00160000
.* *                  IBLOCK   - Internal use only subroutine with      00170000
.* *                             standard linkage and local addressing  00180000
.* *               Modifiers:                                           00190000
.* *                                                                    00200000
.* *                  FROMCMS  - Called from CMS                        00210000
.* *                  NOSAVE   - Method does not use save areas at all  00220000
.* *                  NOCALLS  - Method without its own save area. No   00230000
.* *                             calls will be allowed                  00240000
.* *                                                                    00250000
.* *       &RC      - 'YES'      The routine will return a Return Code  00260000
.* *                             in R15 and the Condition Code based on 00270000
.* *                             the value in R15                       00280000
.* *                  'NO'       This routine does not return a Return  00290000
.* *                             Code and R15 will be restored to the   00300000
.* *                             caller's value                         00310000
.* *                                                                    00320000
.* *       &RESULT    'WORD'     The routine returns a full-word value  00330000
.* *                             in R0. Synonyms are 'BOOL' and 'INT'   00340000
.* *                  'DWORD'    The routine returns a double-word      00350000
.* *                             value in R0+R1                         00360000
.* *                  'TWORD'    The routine returns three words in     00370000
.* *                             R0+R1+R2                               00380000
.* *                  'QWORD'    The routine returns a quad-word value  00390000
.* *                             R0+R1+R2+R3                            00400000
.* *                  'PTR'      The routine returns an address in R1   00410000
.* *                             Synonym is 'ADDR'                      00420000
.* *                  'NONE'     The routine does not return any value  00430000
.* *                                                                    00440000
.* *****************************************************************    00450000
         GBLC  &HSECT             Module CSECT name                     00460000
         GBLB  &HMODRO            Module is read-only                   00470000
         GBLB  &HMODNUC           Module is part of CMS nucleus         00480000
         GBLB  &HNOSA             Method has no local save area         00490000
         GBLB  &HNOSV             Method does not use save areas        00500000
         GBLB  &HRETRC            Method returns R15 and CC             00510000
         GBLB  &HRETR0            Method returns value in R0            00520000
         GBLB  &HRETR1            . . . . . . . . . . . . R1            00530000
         GBLB  &HRETR01           . . . . . . . . . . . . R0-R1         00540000
         GBLB  &HRETR02           . . . . . . . . . . . . R0-R2         00550000
         GBLB  &HRETR03           . . . . . . . . . . . . R0-R3         00560000
         GBLA  &HSADWSZ           Size of dynamic save area             00570000
.*                                                                      00580000
         LCLA  &I                 Looping index                         00590000
         LCLB  &ENT               Externally visible method             00600000
         LCLB  &INT               Internally visible method             00610000
         LCLB  &MOD               Module-level addressability           00620000
         LCLB  &BLK               Method-level addressability           00630000
         LCLB  &CMS               Method marked FROMCMS                 00640000
         LCLC  &PAT               General working string                00650000
.*                                                                      00660000
&I       SETA  0                                                        00670000
         AIF   (T'&PATTERN EQ 'O').PATDEF                               00680000
.PATLP   ANOP  ,                                                        00690000
         AIF   (&I GE N'&PATTERN).PATOK                                 00700000
&I       SETA  &I+1                                                     00710000
&PAT     SETC  '&PATTERN(&I)'                                           00720000
         AIF   ('&PAT' EQ 'STANDARD').PSTD                              00730000
         AIF   ('&PAT' EQ 'INTERNAL').PINT                              00740000
         AIF   ('&PAT' EQ 'BLOCK').PBLK                                 00750000
         AIF   ('&PAT' EQ 'IBLOCK').PIBLK                               00760000
         AIF   ('&PAT' EQ 'FROMCMS').PCMS                               00770000
         AIF   ('&PAT' EQ 'NOCALLS').PNCAL                              00780000
         AIF   ('&PAT' EQ 'NOSAVE').PNSAV                               00790000
         MNOTE 8,'Invalid linkage pattern "&PAT"'                       00800000
         AGO   .PATLP                                                   00810000
.*                                                                      00820000
.*       STANDARD pattern:                                              00830000
.*       -- Externally accessible                                       00840000
.*       -- CSECT/module addressability                                 00850000
.PSTD    ANOP  ,                                                        00860000
         AIF   (&INT).PSTDX                                             00870000
         AIF   (NOT &BLK).PSTD1                                         00880000
.PSTDX   ANOP  ,                                                        00890000
         MNOTE 8,'STANDARD linkage pattern conflict'                    00900000
         AGO   .PATLP                                                   00910000
.PSTD1   ANOP  ,                                                        00920000
.PATDEF  ANOP  ,                                                        00930000
&ENT     SETB  1                                                        00940000
&MOD     SETB  1                                                        00950000
         AGO   .PATLP                                                   00960000
.*                                                                      00970000
.*       INTERNAL pattern:                                              00980000
.*       -- Not externally accessible                                   00990000
.*       -- CSECT/module addressability                                 01000000
.PINT    ANOP  ,                                                        01010000
         AIF   (&ENT).PINTX                                             01020000
         AIF   (NOT &BLK).PINT1                                         01030000
.PINTX   ANOP  ,                                                        01040000
         MNOTE 8,'INTERNAL linkage pattern conflict'                    01050000
         AGO   .PATLP                                                   01060000
.PINT1   ANOP  ,                                                        01070000
&INT     SETB  1                                                        01080000
&MOD     SETB  1                                                        01090000
         AGO   .PATLP                                                   01100000
.*                                                                      01110000
.*       BLOCK pattern:                                                 01120000
.*       -- Externally accessible                                       01130000
.*       -- Method addressability                                       01140000
.PBLK    ANOP  ,                                                        01150000
         AIF   (&INT).PBLKX                                             01160000
         AIF   (NOT &MOD).PBLK1                                         01170000
.PBLKX   ANOP  ,                                                        01180000
         MNOTE 8,'BLOCK linkage pattern conflict'                       01190000
         AGO   .PATLP                                                   01200000
.PBLK1   ANOP  ,                                                        01210000
&ENT     SETB  1                                                        01220000
&BLK     SETB  1                                                        01230000
         AGO   .PATLP                                                   01240000
.*                                                                      01250000
.*       IBLOCK pattern:                                                01260000
.*       -- Not externally accessible                                   01270000
.*       -- Method addressability                                       01280000
.*                                                                      01290000
.PIBLK   ANOP  ,                                                        01300000
         AIF   (&ENT).PIBLKX                                            01310000
         AIF   (NOT &MOD).PIBLK1                                        01320000
.PIBLKX  ANOP  ,                                                        01330000
         MNOTE 8,'IBLOCK linkage pattern conflict'                      01340000
         AGO   .PATLP                                                   01350000
.PIBLK1  ANOP  ,                                                        01360000
&INT     SETB  1                                                        01370000
&BLK     SETB  1                                                        01380000
         AGO   .PATLP                                                   01390000
.*                                                                      01400000
.*       NOCALLS pattern modifier                                       01410000
.PNCAL   ANOP  ,                                                        01420000
&HNOSA   SETB  1                                                        01430000
         AGO   .PATLP                                                   01440000
.*                                                                      01450000
.*       NOSAVE pattern modifier                                        01460000
.PNSAV   ANOP  ,                                                        01470000
&HMOSV   SETB  1                                                        01480000
         AGO   .PATLP                                                   01490000
.*                                                                      01500000
.*       FROMCMS pattern modifier                                       01510000
.PCMS    ANOP  ,                                                        01520000
&CMS     SETB  1                                                        01530000
         AGO   .PATLP                                                   01540000
.PATOK   ANOP  ,                                                        01550000
         AIF   (&INT OR &ENT OR &MOD OR &BLK).DORET                     01560000
         AGO   .PATDEF                                                  01570000
.*                                                                      01580000
.DORET   ANOP  ,                                                        01590000
&HRETRC  SETB  ('&RC' EQ 'YES' OR '&RC' EQ 'TRUE')                      01600000
&HRETR0  SETB  ('&RESULT' EQ 'WORD' OR '&RESULT' EQ 'BOOL')             01610000
&HRETR0  SETB  (&HRETR0 OR '&RESULT' EQ 'INT')                          01620000
&HRETR1  SETB  ('&RESULT' EQ 'PTR' OR '&RESULT' EQ 'ADDR')              01630000
&HRETR01 SETB  ('&RESULT' EQ 'DWORD')                                   01640000
&HRETR02 SETB  ('&RESULT' EQ 'TWORD' OR '&RESULT' EQ '3WORDS')          01650000
&HRETR03 SETB  ('&RESULT' EQ 'QWORD' OR '&RESULT' EQ '4WORDS')          01660000
.*                                                                      01670000
         AIF   (T'&LABEL EQ 'O').NLBL                                   01680000
         AIF   (NOT &ENT).NENTRY                                        01690000
         ENTRY &LABEL                  (External visability)            01700000
.NENTRY  ANOP  ,                                                        01710000
.*                                                                      01720000
&LABEL   DS    0H                      Method entry point               01730000
.NLBL    ANOP  ,                                                        01740000
         PUSH  USING                   Start new scope                  01750000
.*                                                                      01760000
         AIF   (&HNOSV).DOBASE             Save areas not used          01770000
         AIF   (&HNOSA).NSA1               no local save aera           01780000
         USING *,R15                   Temp base register for entry     01790000
.NSA1    ANOP  ,                                                        01800000
         STM   R14,R12,12(R13)         Save caller's registers          01810000
.*                                                                      01820000
         AIF   (&HNOSA).DOBASE            no local save aera            01830000
.*                                                                      01840000
         AIF   (&HMODRO).NLCLSA           no inline save area           01850000
         BAL   R12,19*4(,R15)          Access local save area           01860000
         DC    18F'0'                  (local save area)                01870000
         ST    R12,8(,R13)             Chain save areas together        01880000
         ST    R13,4(,R12)             ...                              01890000
         LR    R13,R12                 and make this the current one    01900000
         AGO   .DOBASE1                   go set base                   01910000
.*                                                                      01920000
.NLCLSA  ANOP  ,                                                        01930000
         AIF   (T'&DWORDS EQ 'O').DWDEF                                 01940000
&HSADWSZ SETA  &DWORDS+9                                                01950000
         LA    R0,9+&DWORDS            Get new save area + local stg    01960000
         AGO   .DWALOC                                                  01970000
.DWDEF   ANOP  ,                                                        01980000
&HSADWSZ SETA  9                                                        01990000
         LA    R0,9                    Get new dynamic save area        02000000
.DWALOC  ANOP  ,                                                        02010000
         AIF   (&HMODNUC).NUCSA           need nucleus save area        02020000
         DMSFREE DWORDS=(0)              from CMS                       02030000
         AGO   .SALK                                                    02040000
.*                                                                      02050000
.NUCSA   ANOP  ,                                                        02060000
         DMSFREE DWORDS=(0),TYPE=NUCLEUS,TYPCALL=BALR                   02080000
.*                                                                      02090000
.SALK    ANOP  ,                                                        02100000
         XC    0(18*4,R1),0(R1)        Clear save area                  02110000
         ST    R1,8(,R13)              Chain save areas together        02120000
         ST    R13,4(,R1)              ...                              02130000
         LR    R12,R1                  (xfer the save area addr)        02140000
         LM    R14,R1,12(R13)          (restore caller's regs)          02150000
         LR    R13,R12                 Now is the current savearea      02160000
.*                                                                      02170000
.DOBASE1 ANOP  ,                                                        02180000
         DROP  R15                     (end temporary addressability)   02190000
.DOBASE  ANOP  ,                                                        02200000
         AIF   (&BLK).BLK2                                              02210000
         LR    R12,R15                 Set permanent base register      02220000
         LA    R15,&LABEL-&HSECT       ...                              02230000
         SLR   R12,R15                 ...                              02240000
         USING &HSECT,R12              ...                              02250000
         MEXIT ,                                                        02260000
.BLK2    ANOP  ,                                                        02270000
         LR    R12,R15                 Set permanent base register      02280000
         USING &LABEL,R12              ...                              02290000
         MEND                                                           02300000
