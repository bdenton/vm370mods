         MACRO                                                          00010000
&LABEL   HICALL &NAME                                                   00020000
.* *****************************************************************    00030000
.* *                                                                    00040000
.* *     Standard VM/CE internal call linkage                           00050000
.* *                                                                    00060000
.* *****************************************************************    00070000
         GBLC  &HSECT             Module CSECT name                     00080000
         GBLB  &HMODRO            Module is read-only                   00090000
         GBLB  &HMODNUC           Module is part of CMS nucleus         00100000
         GBLB  &HNOSA             Method has no local save area         00110000
         GBLB  &HNOSV             Method does not use save areas        00120000
.*                                                                      00130000
         AIF   (NOT (&HNOSA OR &HNOSV)).NWNG                            00140000
         MNOTE 4,'Warning: Methods with the NOCALLS or NOSAVE pattern s-00150000
               hould not make calls'                                    00160000
.NWNG    ANOP  ,                                                        00170000
         AIF   (T'&LABEL EQ 'O').NOLAB                                  00180000
&LABEL   DS    0H                                                       00190000
.NOLAB   ANOP  ,                                                        00200000
         AIF   (T'&NAME EQ 'A' OR T'&NAME EQ 'V').ADDR
         AIF   ('&NAME'(1,1) NE '(').DONAME                             00210000
&R       SETC  '&NAME'(2,K'&NAME-2)                                     00220000
         LR    R15,&R                  Get internal routine address     00230000
         AGO   .CALL                                                    00240000
.ADDR    ANOP  ,
         L     R15,&NAME               Address of called routine
         AGO   .CALL
.DONAME  ANOP  ,                                                        00250000
         L     R15,=A(&NAME)           Address of internal routine      00260000
.CALL    ANOP  ,                                                        00270000
         BALR  R14,R15                 Link to internal routine         00280000
         MEND                                                           00290000
