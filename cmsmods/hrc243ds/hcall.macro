         MACRO                                                          00010000
&LABEL   HCALL &NAME                                                    00020000
.* *****************************************************************    00030000
.* *                                                                    00040000
.* *     Standard VM/CE call linkage                                    00050000
.* *                                                                    00060000
.* *****************************************************************    00070000
         GBLC  &HSECT             Module CSECT name                     00080000
         GBLB  &HMODRO            Module is read-only                   00090000
         GBLB  &HMODNUC           Module is part of CMS nucleus         00100000
         GBLB  &HNOSA             Method has no local save area         00110000
         GBLB  &HNOSV             Method does not use save areas        00120000
         GBLC  &HCALLTB(255)      Keep track of called methods          00130000
         GBLA  &HCALLCT           (the count)                           00140000
.*                                                                      00150000
         LCLA  &I                                                       00160000
         LCLC  &R                                                       00170000
.*                                                                      00180000
         AIF   (NOT (&HNOSA OR &HNOSV)).NWNG                            00190000
         MNOTE 4,'Warning: Methods with the NOCALLS or NOSAVE pattern s-00200000
               hould not make calls'                                    00210000
.NWNG    ANOP  ,                                                        00220000
&I       SETA  1                                                        00230000
         AIF   (T'&LABEL EQ 'O').NOLAB                                  00240000
&LABEL   DS    0H                                                       00250000
.NOLAB   ANOP  ,                                                        00260000
         AIF   (T'&NAME EQ 'O').NONAME                                  00270000
         AIF   (T'&NAME EQ 'T').NOEXT   Already an EXTRN                00280000
         AIF   (T'&NAME EQ 'A' OR T'&NAME EQ 'V').ADDR
         AIF   ('&NAME'(1,1) NE '(').LOOP                               00310000
&R       SETC  '&NAME'(2,K'&NAME-2)                                     00320000
         AGO   .REG                                                     00330000
.LOOP    ANOP  ,                                                        00340000
         AIF   (&I GT &HCALLCT).ADD                                     00350000
         AIF   ('&HCALLTB(&I)' EQ '&NAME').NOEXT                        00360000
&I       SETA  &I+1                                                     00370000
         AGO   .LOOP                                                    00380000
.ADD     ANOP                                                           00390000
&HCALLCT SETA  &HCALLCT+1                                               00400000
&HCALLTB(&HCALLCT) SETC '&NAME'                                         00410000
         EXTRN &NAME                   External reference               00420000
.NOEXT   ANOP  ,                                                        00430000
         L     R15,=A(&NAME)           Address of called routine        00440000
         AGO   .NONAME                                                  00450000
.ADDR    ANOP  ,
         L     R15,&NAME               Address of called routine
         AGO   .NONAME
.REG     ANOP  ,                                                        00460000
         AIF   ('&R' EQ '15' OR '&R' EQ 'R15').NONAME                   00470000
         LR    R15,&R                  Get routine address              00480000
.NONAME  ANOP  ,                                                        00490000
         BALR  R14,R15                 Link to routine                  00500000
         MEND                                                           00510000
