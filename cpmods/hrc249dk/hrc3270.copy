*                                                                       00190000
*        3270DS Write Control Character (WCC) BIts                      00200000
*                                                                       00210000
WCCRESET EQU   X'40'     Reset Bit                                      00220000
WCCFMTNL EQU   X'00'     Printout Format - use NL/CR/EM                 00230000
WCCFMT40 EQU   X'10'                     - 40 char line                 00240000
WCCFMT64 EQU   X'20'                     - 64 char line                 00250000
WCCFMT80 EQU   X'30'                     - 80 char line                 00260000
WCCSTPRT EQU   X'08'     Start Print                                    00270000
WCCALARM EQU   X'04'     Sound Alarm                                    00280000
WCCKBRST EQU   X'02'     Keyboard Restore                               00290000
WCCRSMDT EQU   X'01'     Reset MDT Bits                                 00300000
*                                                                       00310000
*        Shortcuts for frequently used WCCs                             00320000
*                                                                       00330000
WCCDFLT  EQU   X'C0'     Default: nothing special                       00340000
WCCUNLK  EQU   X'C2'     Unlock keyboard                                00350000
WCCNMDT  EQU   X'C3'     Unlock keyboard + reset MDTs                   00360000
WCCBEEP  EQU   X'C6'     Unlock keyboard + alarm                        00370000
*                                                                       00380000
*        3270DS Buffer Orders                                           00390000
*                                                                       00400000
SBA      EQU   X'11'     Set Buffer Address                             00410000
SF       EQU   X'1D'     Start Field                                    00420000
IC       EQU   X'13'     Insert Cursor                                  00430000
PT       EQU   X'05'     Program Tab                                    00440000
RA       EQU   X'3C'     Repeat to Address                              00450000
EUA      EQU   X'12'     Erase All Unprotected                          00460000
SFE      EQU   X'29'     Start Field Extended                           00470000
MF       EQU   X'2C'     Modify Field                                   00480000
SA       EQU   X'28'     Set Attribute                                  00490000
GE       EQU   X'08'     Graphic Escape                                 00500000
*                                                                       00510000
*        3270DS Buffer Address Masks                                    00520000
*                                                                       00530000
*        TM    addr,ADMASK   Example                                    00540000
*        BZ    is14bit         coding                                   00550000
*        BO    is12bit           determining                            00560000
*        TM    addr,AD12BITA       buffer                               00570000
*        BO    is12bit               address                            00580000
*        error: bad address            structure                        00590000
*                                                                       00600000
ADMASK   EQU   X'C0'     Address size mask                              00610000
AS16BIT  EQU   X'00'     00 - 16-bit address                            00620000
AD12BITA EQU   X'40'     01 - 12-bit address                            00630000
ADINV    EQU   X'80'     10 - invalid                                   00640000
AD12BITB EQU   X'C0'     11 - 12-bit address                            00650000
*                                                                       00660000
*        3270DS Format Control Orders                                   00670000
*                                                                       00680000
CH@NUL   EQU   X'00'     Null: A blank, suppressed on Read Modified     00690000
CH@SUB   EQU   X'3F'     Substitute: A solid circle                     00700000
CH@DUP   EQU   X'1C'     Duplicate: An overscore asterisk               00710000
CH@FM    EQU   X'1E'     Field Mark: An overscore semicolon             00720000
CH@FF    EQU   X'0C'     Form Feed: A blank                             00730000
CH@CR    EQU   X'0D'     Carriage Return: A blank                       00740000
CH@NL    EQU   X'15'     New Line: A blank                              00750000
CH@EM    EQU   X'19'     End of Media: A blank                          00760000
CH@EO    EQU   X'FF'     Eight Ones: A blank                            00770000
*                                                                       00780000
